generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum CitizenStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdminUserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceVersionLifecycleStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum FormVersionStatus {
  DRAFT
  PUBLISHED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  DATE
  TIME
  DATETIME
  DROPDOWN
  RADIO
  CHECKBOX
  MULTI_SELECT
  FILE
  IMAGE
  DOCUMENT
  ADDRESS
  PINCODE
  STATE
  DISTRICT
  CITY
  COUNTRY
}

enum ApplicationStatus {
  DRAFT
  FORM_IN_PROGRESS
  DOCUMENTS_PENDING
  PAYMENT_PENDING
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  PROCESSING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum StoredFileStatus {
  PENDING
  UPLOADED
  VERIFIED
  ATTACHED
  EXPIRED
  FAILED
}

enum UploadSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum ApplicationDocumentStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ActionRequestStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum StorageProviderType {
  LOCAL
  S3
  CLOUDINARY
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MainServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BbpsBillRequestStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum BbpsBillPaymentStatus {
  PROCESSING
  PENDING
  SUCCESS
  FAILED
}

enum BbpsSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ─── Identity & Access ───────────────────────────────────────────────────────

model Citizen {
  id        String        @id @default(cuid())
  phone     String        @unique
  email     String?       @unique
  firstName String?       @map("first_name")
  lastName  String?       @map("last_name")
  status    CitizenStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  applications    Application[]
  refreshTokens   CitizenRefreshToken[]
  otpChallenges   CitizenOtpChallenge[]
  storedFiles     StoredFile[]
  uploadSessions  UploadSession[]
  payments        Payment[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  addresses       CitizenAddress[]
  savedDocuments  CitizenSavedDocument[]
  bbpsSavedBillers BbpsSavedBiller[]
  bbpsBillRequests BbpsBillRequest[]
  bbpsBillPayments BbpsBillPayment[]
  manualApplySessions ManualApplySession[]
  manualApplyPayments ManualApplyPayment[]

  @@map("citizens")
}

model CitizenAddress {
  id        String   @id @default(cuid())
  citizenId String   @map("citizen_id")
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@map("citizen_addresses")
}

model CitizenSavedDocument {
  id               String   @id @default(cuid())
  citizenId        String   @map("citizen_id")
  name             String
  documentType     String?  @map("document_type")
  storedFileId     String?  @map("stored_file_id")
  mimeType         String?  @map("mime_type")
  originalFileName String?  @map("original_file_name")
  createdAt        DateTime @default(now()) @map("created_at")

  citizen    Citizen     @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  storedFile StoredFile? @relation(fields: [storedFileId], references: [id])

  @@index([citizenId])
  @@map("citizen_saved_documents")
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String          @map("password_hash")
  firstName    String?         @map("first_name")
  lastName     String?         @map("last_name")
  status       AdminUserStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  operatorProfile       OperatorProfile?
  roles                 AdminUserRole[]
  refreshTokens         AdminRefreshToken[]
  assignedApplications  Application[]              @relation("AssignedOperator")
  statusHistory         ApplicationStatusHistory[]
  internalNotes         ApplicationInternalNote[]
  auditLogs             AuditLog[]

  @@map("admin_users")
}

model OperatorProfile {
  id           String  @id @default(cuid())
  adminUserId  String  @unique @map("admin_user_id")
  department   String?
  maxWorkload  Int?    @map("max_workload")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("operator_profiles")
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  permissions RolePermission[]
  adminUsers  AdminUserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  module      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUserRole {
  adminUserId String   @map("admin_user_id")
  roleId      String   @map("role_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  String?  @map("assigned_by")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model CitizenRefreshToken {
  id         String    @id @default(cuid())
  citizenId  String    @map("citizen_id")
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@map("citizen_refresh_tokens")
}

model AdminRefreshToken {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_refresh_tokens")
}

model CitizenOtpChallenge {
  id        String    @id @default(cuid())
  citizenId String?   @map("citizen_id")
  phone     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  citizen Citizen? @relation(fields: [citizenId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@map("citizen_otp_challenges")
}

// ─── Service Catalogue ───────────────────────────────────────────────────────

model MainService {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  iconUrl     String?           @map("icon_url")
  sortOrder   Int               @default(0) @map("sort_order")
  status      MainServiceStatus @default(ACTIVE)
  isVisible   Boolean           @default(true) @map("is_visible")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  subServices SubService[]
  homeBanners HomeBanner[]

  @@map("main_services")
}

model SubService {
  id            String           @id @default(cuid())
  mainServiceId String           @map("main_service_id")
  name          String
  slug          String
  description   String?
  sortOrder     Int              @default(0) @map("sort_order")
  status        SubServiceStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  mainService MainService      @relation(fields: [mainServiceId], references: [id], onDelete: Cascade)
  versions    ServiceVersion[]
  homeBanners HomeBanner[]

  @@unique([mainServiceId, slug])
  @@map("sub_services")
}

model ServiceVersion {
  id              String                        @id @default(cuid())
  subServiceId    String                        @map("sub_service_id")
  versionNumber   Int                           @map("version_number")
  lifecycleStatus ServiceVersionLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  publishedAt     DateTime?                     @map("published_at")
  publishedById   String?                       @map("published_by_id")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")

  subService          SubService           @relation(fields: [subServiceId], references: [id], onDelete: Cascade)
  overview            ServiceOverview?
  fulfillmentConfig   ServiceFulfillmentConfig?
  formVersion         FormVersion?
  documentRequirements DocumentRequirement[]
  pricingConfig       PricingConfig?
  workflowDefinition  WorkflowDefinition?
  applications        Application[]

  @@unique([subServiceId, versionNumber])
  @@index([subServiceId, lifecycleStatus])
  @@map("service_versions")
}

model ServiceOverview {
  id               String @id @default(cuid())
  serviceVersionId String @unique @map("service_version_id")
  displayName      String @map("display_name")
  shortDescription String? @map("short_description")
  richDescription  String? @map("rich_description")
  instructions     String?
  termsAndConditions String? @map("terms_and_conditions")
  processingTime   String? @map("processing_time")
  department       String?
  seoTags          String[] @map("seo_tags")
  translations     Json?    @default("{}")

  serviceVersion ServiceVersion @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)

  @@map("service_overviews")
}

enum ManualApplySessionStatus {
  PENDING_PAYMENT
  PAID
  REDIRECTED
  USER_CONFIRMED
  CANCELLED
}

model ServiceFulfillmentConfig {
  id                     String  @id @default(cuid())
  serviceVersionId       String  @unique @map("service_version_id")
  assistedEnabled        Boolean @default(true) @map("assisted_enabled")
  manualEnabled          Boolean @default(false) @map("manual_enabled")
  assistedCtaLabel       String  @default("Get it done by us") @map("assisted_cta_label")
  manualCtaLabel         String  @default("Apply on official portal") @map("manual_cta_label")
  requiresStateSelection Boolean @default(false) @map("requires_state_selection")
  defaultPlatformFee     Decimal @default(49) @map("default_platform_fee") @db.Decimal(12, 2)
  defaultPortalUrl       String? @map("default_portal_url")
  manualInstructions     String? @map("manual_instructions")

  serviceVersion ServiceVersion        @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  stateVariants  ServiceStateVariant[]

  @@map("service_fulfillment_configs")
}

model ServiceStateVariant {
  id                  String   @id @default(cuid())
  fulfillmentConfigId String   @map("fulfillment_config_id")
  stateCode           String   @map("state_code")
  stateName           String   @map("state_name")
  assistedEnabled     Boolean  @default(true) @map("assisted_enabled")
  manualEnabled       Boolean  @default(true) @map("manual_enabled")
  officialPortalUrl   String?  @map("official_portal_url")
  platformFee         Decimal? @map("platform_fee") @db.Decimal(12, 2)
  baseFeeOverride     Decimal? @map("base_fee_override") @db.Decimal(12, 2)
  processingTime      String?  @map("processing_time")
  department          String?  @map("department")
  sortOrder           Int      @default(0) @map("sort_order")

  fulfillmentConfig ServiceFulfillmentConfig @relation(fields: [fulfillmentConfigId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentConfigId, stateCode])
  @@map("service_state_variants")
}

model ManualApplySession {
  id                String                   @id @default(cuid())
  citizenId         String                   @map("citizen_id")
  subServiceId      String                   @map("sub_service_id")
  serviceVersionId  String                   @map("service_version_id")
  stateCode         String?                  @map("state_code")
  stateName         String?                  @map("state_name")
  serviceName       String                   @map("service_name")
  officialPortalUrl String                   @map("official_portal_url")
  platformFee       Decimal                  @map("platform_fee") @db.Decimal(12, 2)
  status            ManualApplySessionStatus @default(PENDING_PAYMENT)
  redirectedAt      DateTime?                @map("redirected_at")
  confirmedAt       DateTime?                @map("confirmed_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  citizen Citizen              @relation(fields: [citizenId], references: [id])
  payment ManualApplyPayment?

  @@index([citizenId, createdAt])
  @@map("manual_apply_sessions")
}

model ManualApplyPayment {
  id                   String        @id @default(cuid())
  manualApplySessionId String        @unique @map("manual_apply_session_id")
  citizenId            String        @map("citizen_id")
  provider             String
  providerRef          String?       @map("provider_ref")
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  idempotencyKey       String        @unique @map("idempotency_key")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  manualApplySession ManualApplySession @relation(fields: [manualApplySessionId], references: [id], onDelete: Cascade)
  citizen            Citizen            @relation(fields: [citizenId], references: [id])

  @@map("manual_apply_payments")
}

model FormVersion {
  id               String            @id @default(cuid())
  serviceVersionId String            @unique @map("service_version_id")
  versionNumber    Int               @default(1) @map("version_number")
  status           FormVersionStatus @default(DRAFT)

  serviceVersion ServiceVersion @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  fields         FormField[]
  conditions     FormCondition[]
  applications   Application[]

  @@map("form_versions")
}

model FormField {
  id            String        @id @default(cuid())
  formVersionId String        @map("form_version_id")
  key           String
  label         String
  type          FormFieldType
  sortOrder     Int           @default(0) @map("sort_order")
  required      Boolean       @default(false)
  visible       Boolean       @default(true)
  placeholder   String?
  helpText      String?       @map("help_text")
  defaultValue  String?       @map("default_value")
  config        Json          @default("{}")
  validation    Json          @default("{}")

  formVersion FormVersion       @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  options     FormFieldOption[]

  @@unique([formVersionId, key])
  @@map("form_fields")
}

model FormFieldOption {
  id          String @id @default(cuid())
  formFieldId String @map("form_field_id")
  label       String
  value       String
  sortOrder   Int    @default(0) @map("sort_order")

  formField FormField @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@map("form_field_options")
}

model FormCondition {
  id            String @id @default(cuid())
  formVersionId String @map("form_version_id")
  sourceFieldKey String @map("source_field_key")
  operator      String
  value         String
  action        String
  targetFieldKeys String[] @map("target_field_keys")
  rule          Json   @default("{}")

  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)

  @@map("form_conditions")
}

model DocumentRequirement {
  id               String  @id @default(cuid())
  serviceVersionId String  @map("service_version_id")
  name             String
  description      String?
  required         Boolean @default(true)
  allowedFormats   String[] @map("allowed_formats")
  allowedMimeTypes String[] @map("allowed_mime_types")
  maxFileSizeBytes Int     @map("max_file_size_bytes")
  maxFiles         Int     @default(1) @map("max_files")
  instructions     String?
  sortOrder        Int     @default(0) @map("sort_order")
  config           Json    @default("{}")

  serviceVersion      ServiceVersion       @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  applicationDocuments ApplicationDocument[]

  @@map("document_requirements")
}

model PricingConfig {
  id               String  @id @default(cuid())
  serviceVersionId String  @unique @map("service_version_id")
  baseFee          Decimal @map("base_fee") @db.Decimal(12, 2)
  taxEnabled       Boolean @default(false) @map("tax_enabled")
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  currency         String  @default("INR")

  serviceVersion   ServiceVersion     @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  additionalCharges AdditionalCharge[]

  @@map("pricing_configs")
}

model AdditionalCharge {
  id              String  @id @default(cuid())
  pricingConfigId String  @map("pricing_config_id")
  name            String
  amount          Decimal @db.Decimal(12, 2)
  condition       String?

  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@map("additional_charges")
}

model WorkflowDefinition {
  id               String @id @default(cuid())
  serviceVersionId String @unique @map("service_version_id")

  serviceVersion ServiceVersion       @relation(fields: [serviceVersionId], references: [id], onDelete: Cascade)
  steps          WorkflowStep[]
  transitions    WorkflowTransition[]
  applications   Application[]

  @@map("workflow_definitions")
}

model WorkflowStep {
  id                   String            @id @default(cuid())
  workflowDefinitionId String            @map("workflow_definition_id")
  stepKey              String            @map("step_key")
  name                 String
  description          String?
  sortOrder            Int               @default(0) @map("sort_order")
  applicationStatus    ApplicationStatus @map("application_status")
  isInitial            Boolean           @default(false) @map("is_initial")
  isTerminal           Boolean           @default(false) @map("is_terminal")
  citizenVisible       Boolean           @default(true) @map("citizen_visible")
  slaHours             Int?              @map("sla_hours")

  workflowDefinition WorkflowDefinition   @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  transitionsFrom    WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo      WorkflowTransition[] @relation("TransitionTo")
  currentApplications Application[]       @relation("CurrentWorkflowStep")

  @@unique([workflowDefinitionId, stepKey])
  @@map("workflow_steps")
}

model WorkflowTransition {
  id                   String   @id @default(cuid())
  workflowDefinitionId String   @map("workflow_definition_id")
  fromStepId           String   @map("from_step_id")
  toStepId             String   @map("to_step_id")
  actionKey            String   @map("action_key")
  label                String
  allowedRoleIds       String[] @map("allowed_role_ids")
  requiredPermissions  String[] @map("required_permissions")
  requiresComment      Boolean  @default(false) @map("requires_comment")
  requiresAssignment   Boolean  @default(false) @map("requires_assignment")
  createsActionRequest Boolean  @default(false) @map("creates_action_request")
  notifyCitizen        Boolean  @default(false) @map("notify_citizen")
  guardConfig          Json     @default("{}") @map("guard_config")

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  fromStep           WorkflowStep       @relation("TransitionFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep             WorkflowStep       @relation("TransitionTo", fields: [toStepId], references: [id], onDelete: Cascade)

  @@map("workflow_transitions")
}

// ─── Applications ────────────────────────────────────────────────────────────

model Application {
  id                   String            @id @default(cuid())
  publicRef            String?           @unique @map("public_ref")
  citizenId            String            @map("citizen_id")
  serviceVersionId     String            @map("service_version_id")
  formVersionId        String            @map("form_version_id")
  workflowDefinitionId String            @map("workflow_definition_id")
  currentWorkflowStepId String?          @map("current_workflow_step_id")
  status               ApplicationStatus @default(DRAFT)
  applicantStateCode   String?           @map("applicant_state_code")
  applicantStateName   String?           @map("applicant_state_name")
  assignedOperatorId   String?           @map("assigned_operator_id")
  submittedAt          DateTime?         @map("submitted_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  citizen              Citizen                    @relation(fields: [citizenId], references: [id])
  serviceVersion       ServiceVersion             @relation(fields: [serviceVersionId], references: [id])
  formVersion          FormVersion                @relation(fields: [formVersionId], references: [id])
  workflowDefinition   WorkflowDefinition         @relation(fields: [workflowDefinitionId], references: [id])
  currentWorkflowStep  WorkflowStep?              @relation("CurrentWorkflowStep", fields: [currentWorkflowStepId], references: [id])
  assignedOperator     AdminUser?                 @relation("AssignedOperator", fields: [assignedOperatorId], references: [id])
  configSnapshot       ApplicationConfigSnapshot?
  pricingSnapshot      ApplicationPricingSnapshot?
  fieldValues          ApplicationFieldValue[]
  documents            ApplicationDocument[]
  statusHistory        ApplicationStatusHistory[]
  actionRequests       ApplicationActionRequest[]
  internalNotes        ApplicationInternalNote[]
  payment              Payment?
  certificate          ApplicationCertificate?

  @@index([citizenId, status])
  @@index([serviceVersionId])
  @@map("applications")
}

model ApplicationCertificate {
  id                String   @id @default(cuid())
  applicationId     String   @unique @map("application_id")
  certificateNumber String   @map("certificate_number")
  issuedAt          DateTime @map("issued_at")
  title             String
  pdfStorageKey     String?  @map("pdf_storage_key")
  createdAt         DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_certificates")
}

model ApplicationConfigSnapshot {
  id            String   @id @default(cuid())
  applicationId String   @unique @map("application_id")
  payload       Json
  capturedAt    DateTime @default(now()) @map("captured_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_config_snapshots")
}

model ApplicationPricingSnapshot {
  id                String   @id @default(cuid())
  applicationId     String   @unique @map("application_id")
  baseFee           Decimal  @map("base_fee") @db.Decimal(12, 2)
  taxAmount         Decimal  @map("tax_amount") @db.Decimal(12, 2)
  taxRate           Decimal  @map("tax_rate") @db.Decimal(5, 2)
  currency          String   @default("INR")
  additionalCharges Json     @default("[]") @map("additional_charges")
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount       Decimal  @map("total_amount") @db.Decimal(12, 2)
  capturedAt        DateTime @default(now()) @map("captured_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_pricing_snapshots")
}

model ApplicationFieldValue {
  id            String @id @default(cuid())
  applicationId String @map("application_id")
  fieldKey      String @map("field_key")
  value         Json

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, fieldKey])
  @@map("application_field_values")
}

model ApplicationDocument {
  id                    String                    @id @default(cuid())
  applicationId         String                    @map("application_id")
  documentRequirementId String                    @map("document_requirement_id")
  storedFileId          String                    @map("stored_file_id")
  status                ApplicationDocumentStatus @default(PENDING)
  rejectionReason       String?                   @map("rejection_reason")
  uploadedAt            DateTime                  @default(now()) @map("uploaded_at")

  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentRequirement DocumentRequirement @relation(fields: [documentRequirementId], references: [id])
  storedFile          StoredFile          @relation(fields: [storedFileId], references: [id])

  @@map("application_documents")
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  fromStatus    ApplicationStatus @map("from_status")
  toStatus      ApplicationStatus @map("to_status")
  actionKey     String?           @map("action_key")
  actorAdminId  String?           @map("actor_admin_id")
  comment       String?
  createdAt     DateTime          @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorAdmin  AdminUser?  @relation(fields: [actorAdminId], references: [id])

  @@index([applicationId])
  @@map("application_status_history")
}

model ApplicationActionRequest {
  id                      String              @id @default(cuid())
  applicationId           String              @map("application_id")
  reason                  String
  instructions            String?
  requiredDocumentIds     String[]            @map("required_document_ids")
  requiredFieldKeys       String[]            @map("required_field_keys")
  status                  ActionRequestStatus @default(OPEN)
  deadline                DateTime?
  resolvedAt              DateTime?           @map("resolved_at")
  createdAt               DateTime            @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_action_requests")
}

model ApplicationInternalNote {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  authorAdminId String   @map("author_admin_id")
  content       String
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorAdmin AdminUser   @relation(fields: [authorAdminId], references: [id])

  @@map("application_internal_notes")
}

// ─── File Storage ────────────────────────────────────────────────────────────

model UploadSession {
  id                    String              @id @default(cuid())
  citizenId             String              @map("citizen_id")
  applicationId         String?             @map("application_id")
  documentRequirementId String?             @map("document_requirement_id")
  expectedMimeType      String              @map("expected_mime_type")
  expectedMaxSizeBytes  Int                 @map("expected_max_size_bytes")
  originalFileName      String              @map("original_file_name")
  status                UploadSessionStatus @default(PENDING)
  expiresAt             DateTime            @map("expires_at")
  createdAt             DateTime            @default(now()) @map("created_at")

  citizen     Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  storedFiles StoredFile[]

  @@index([citizenId])
  @@map("upload_sessions")
}

model StoredFile {
  id               String              @id @default(cuid())
  uploadSessionId  String?             @map("upload_session_id")
  ownerCitizenId   String              @map("owner_citizen_id")
  storageProvider  StorageProviderType @map("storage_provider")
  storageKey       String              @unique @map("storage_key")
  originalFileName String              @map("original_file_name")
  mimeType         String              @map("mime_type")
  sizeBytes        Int                 @default(0) @map("size_bytes")
  checksumSha256   String?             @map("checksum_sha256")
  status           StoredFileStatus    @default(PENDING)
  createdAt        DateTime            @default(now()) @map("created_at")
  verifiedAt       DateTime?           @map("verified_at")
  attachedAt       DateTime?           @map("attached_at")

  uploadSession        UploadSession?         @relation(fields: [uploadSessionId], references: [id])
  ownerCitizen         Citizen                @relation(fields: [ownerCitizenId], references: [id])
  applicationDocuments ApplicationDocument[]
  savedDocuments       CitizenSavedDocument[]

  @@index([ownerCitizenId, status])
  @@map("stored_files")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  applicationId  String        @unique @map("application_id")
  citizenId      String        @map("citizen_id")
  provider       String
  providerRef    String?       @map("provider_ref")
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(CREATED)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  application  Application          @relation(fields: [applicationId], references: [id])
  citizen      Citizen              @relation(fields: [citizenId], references: [id])
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@map("payments")
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  paymentId   String   @map("payment_id")
  eventType   String   @map("event_type")
  providerRef String?  @map("provider_ref")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @map("event_id")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String       @map("payment_id")
  amount      Decimal      @db.Decimal(12, 2)
  status      RefundStatus @default(PENDING)
  providerRef String?      @map("provider_ref")
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

// ─── Bill Payments (BBPS) ─────────────────────────────────────────────────────

model BbpsCategory {
  id               String    @id @default(cuid())
  providerCategory String    @unique @map("provider_category")
  displayName      String    @map("display_name")
  icon             String?
  description      String?
  appStatus        String    @default("active") @map("app_status")
  displayOrder     Int       @default(0) @map("display_order")
  isFeatured       Boolean   @default(false) @map("is_featured")
  lastSyncedAt     DateTime? @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  billers BbpsBiller[]

  @@map("bbps_categories")
}

model BbpsBiller {
  id                  String    @id @default(cuid())
  razorpayBillerId    String    @unique @map("razorpay_biller_id")
  gatewayBillerId     String?   @map("gateway_biller_id")
  name                String
  aliasName           String?   @map("alias_name")
  internalAlias       String?   @map("internal_alias")
  internalDescription String?   @map("internal_description")
  categoryId          String    @map("category_id")
  providerCategory    String    @map("provider_category")
  providerStatus      String    @default("active") @map("provider_status")
  isVisible           Boolean   @default(true) @map("is_visible")
  isFeatured          Boolean   @default(false) @map("is_featured")
  displayOrder        Int       @default(0) @map("display_order")
  country             String?
  state               String?
  city                String?
  logoUrl             String?   @map("logo_url")
  supportedChannels   Json      @default("[]") @map("supported_channels")
  accountHolderConfig Json      @default("{}") @map("account_holder_config")
  billRequestConfig   Json      @default("{}") @map("bill_request_config")
  paymentConfig       Json      @default("{}") @map("payment_config")
  feeConfig           Json      @default("{}") @map("fee_config")
  rawConfiguration    Json      @default("{}") @map("raw_configuration")
  gatewayUpdatedAt    DateTime? @map("gateway_updated_at")
  lastSyncedAt        DateTime? @map("last_synced_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  category     BbpsCategory      @relation(fields: [categoryId], references: [id])
  savedBillers BbpsSavedBiller[]
  billRequests BbpsBillRequest[]
  billPayments BbpsBillPayment[]

  @@index([providerCategory, isVisible])
  @@index([categoryId])
  @@index([name])
  @@map("bbps_billers")
}

model BbpsBillRequest {
  id                    String                @id @default(cuid())
  citizenId             String                @map("citizen_id")
  billerId              String                @map("biller_id")
  razorpayBillRequestId String?               @unique @map("razorpay_bill_request_id")
  status                BbpsBillRequestStatus @default(PROCESSING)
  accountHolderData     Json                  @default("{}") @map("account_holder_data")
  billDetails           Json?
  customerName          String?               @map("customer_name")
  billAmount            Decimal?              @map("bill_amount") @db.Decimal(12, 2)
  dueDate               DateTime?             @map("due_date")
  billNumber            String?               @map("bill_number")
  errorCode             String?               @map("error_code")
  errorMessage          String?               @map("error_message")
  providerError         Json?                 @map("provider_error")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  citizen     Citizen           @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  biller      BbpsBiller        @relation(fields: [billerId], references: [id])
  billPayment BbpsBillPayment?

  @@index([citizenId, createdAt])
  @@map("bbps_bill_requests")
}

model BbpsBillPayment {
  id                    String                @id @default(cuid())
  citizenId             String                @map("citizen_id")
  billerId              String                @map("biller_id")
  billRequestId         String?               @unique @map("bill_request_id")
  razorpayBillPaymentId String?               @unique @map("razorpay_bill_payment_id")
  razorpayPaymentId     String?               @map("razorpay_payment_id")
  razorpayOrderId       String?               @map("razorpay_order_id")
  status                BbpsBillPaymentStatus @default(PROCESSING)
  billAmount            Decimal               @map("bill_amount") @db.Decimal(12, 2)
  convenienceFee        Decimal               @default(0) @map("convenience_fee") @db.Decimal(12, 2)
  totalAmount           Decimal               @map("total_amount") @db.Decimal(12, 2)
  currency              String                @default("INR")
  billDetails           Json                  @default("{}") @map("bill_details")
  accountHolderMasked   String?               @map("account_holder_masked")
  references            Json                  @default("{}")
  errorCode             String?               @map("error_code")
  errorMessage          String?               @map("error_message")
  providerError         Json?                 @map("provider_error")
  idempotencyKey        String                @unique @map("idempotency_key")
  paidAt                DateTime?             @map("paid_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  citizen     Citizen          @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  biller      BbpsBiller       @relation(fields: [billerId], references: [id])
  billRequest BbpsBillRequest? @relation(fields: [billRequestId], references: [id])

  @@index([citizenId, createdAt])
  @@index([status])
  @@map("bbps_bill_payments")
}

model BbpsSavedBiller {
  id                String   @id @default(cuid())
  citizenId         String   @map("citizen_id")
  billerId          String   @map("biller_id")
  nickname          String?
  accountHolderData Json     @default("{}") @map("account_holder_data")
  displayMasked     String?  @map("display_masked")
  lastUsedAt        DateTime @default(now()) @map("last_used_at")
  lastPaymentAmount Decimal? @map("last_payment_amount") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  citizen Citizen    @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  biller  BbpsBiller @relation(fields: [billerId], references: [id])

  @@unique([citizenId, billerId, displayMasked])
  @@index([citizenId])
  @@map("bbps_saved_billers")
}

model BbpsIntegrationLog {
  id            String   @id @default(cuid())
  integration   String   @default("razorpay_bbps")
  endpoint      String
  requestId     String?  @map("request_id")
  internalRefId String?  @map("internal_ref_id")
  httpStatus    Int?     @map("http_status")
  durationMs    Int?     @map("duration_ms")
  success       Boolean
  errorCode     String?  @map("error_code")
  errorReason   String?  @map("error_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([internalRefId])
  @@map("bbps_integration_logs")
}

model BbpsSyncRun {
  id             String         @id @default(cuid())
  syncType       String         @map("sync_type")
  status         BbpsSyncStatus @default(RUNNING)
  itemsProcessed Int            @default(0) @map("items_processed")
  errorMessage   String?        @map("error_message")
  startedAt      DateTime       @default(now()) @map("started_at")
  completedAt    DateTime?      @map("completed_at")

  @@index([startedAt])
  @@map("bbps_sync_runs")
}

// ─── Platform ─────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  citizenId String?             @map("citizen_id")
  adminUserId String?           @map("admin_user_id")
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?           @map("read_at")
  metadata  Json                @default("{}")
  createdAt DateTime            @default(now()) @map("created_at")

  citizen    Citizen?               @relation(fields: [citizenId], references: [id])
  deliveries NotificationDelivery[]

  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String              @map("notification_id")
  channel        NotificationChannel
  status         String
  deliveredAt    DateTime?           @map("delivered_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
}

model SupportTicket {
  id        String              @id @default(cuid())
  citizenId String              @map("citizen_id")
  subject   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  citizen  Citizen         @relation(fields: [citizenId], references: [id])
  messages TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  senderType String  @map("sender_type")
  senderId  String   @map("sender_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model GovernmentScheme {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  ministry            String?
  category            String
  description         String
  whoCanApply         String   @map("who_can_apply")
  eligibility         String
  documentsRequired   String[] @default([]) @map("documents_required")
  officialPortalUrl   String   @map("official_portal_url")
  officialPortalLabel String   @default("Official Portal") @map("official_portal_label")
  displayOrder        Int      @default(0) @map("display_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@index([category])
  @@map("government_schemes")
}

model HomeBanner {
  id             String    @id @default(cuid())
  tag            String?
  title          String
  description    String?
  ctaLabel       String    @default("Learn More") @map("cta_label")
  imageUrl       String?   @map("image_url")
  gradientStart  String    @default("#1E40AF") @map("gradient_start")
  gradientMiddle String?   @map("gradient_middle")
  gradientEnd    String    @default("#3B82F6") @map("gradient_end")
  mainServiceId  String    @map("main_service_id")
  subServiceId   String    @map("sub_service_id")
  placement      String    @default("home")
  displayOrder   Int       @default(0) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  translations   Json?     @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  mainService MainService @relation(fields: [mainServiceId], references: [id], onDelete: Cascade)
  subService  SubService  @relation(fields: [subServiceId], references: [id], onDelete: Cascade)

  @@index([placement, isActive, displayOrder])
  @@map("home_banners")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorAdminId String?  @map("actor_admin_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id])

  @@index([createdAt, resourceType, resourceId])
  @@map("audit_logs")
}
