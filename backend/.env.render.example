# Copy-paste into Render → cybersave-api → Environment (if not using Blueprint)

NODE_ENV=production
API_PREFIX=api/v1
AUTO_SEED=true

# DATABASE_URL is auto-filled when you link Render Postgres
# Or paste a Neon/Supabase Postgres URL here

CITIZEN_JWT_SECRET=cybersave-citizen-demo-secret-change-me-32
ADMIN_JWT_SECRET=cybersave-admin-demo-secret-change-me-32xx
CITIZEN_JWT_EXPIRES_IN=15m
ADMIN_JWT_EXPIRES_IN=15m
CITIZEN_JWT_AUDIENCE=cybersave-mobile
ADMIN_JWT_AUDIENCE=cybersave-admin
CITIZEN_REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_REFRESH_TOKEN_EXPIRES_DAYS=7

OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
CORS_ORIGINS=*
SWAGGER_ENABLED=true

SMS_PROVIDER=console
PAYMENT_PROVIDER=mock
SKIP_PAYMENT_VERIFICATION=true
BBPS_PROVIDER=mock
BBPS_CONVENIENCE_FEE_FLAT=5
