# Copy values into Render → cybersave-api → Environment
# Free Postgres: https://neon.tech → create project → copy connection string

NODE_ENV=production
API_PREFIX=api/v1
AUTO_SEED=true

# Required — Neon (or any Postgres) connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional — if omitted, JWT secrets are auto-derived from DATABASE_URL at boot
# CITIZEN_JWT_SECRET=long-random-string-min-32-chars
# ADMIN_JWT_SECRET=another-long-random-string-min-32-chars
# APP_SECRET=single-secret-used-for-both-if-individual-keys-not-set

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# After first deploy, set this to your public API URL (no trailing slash):
# STORAGE_PUBLIC_BASE_URL=https://cybersave-api.onrender.com

CORS_ORIGINS=*
SWAGGER_ENABLED=true
SMS_PROVIDER=whatsapp
AUTH_PROVIDER=legacy
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=cybersave_otp
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_STYLE=body
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PAYMENT_PROVIDER=razorpay
SKIP_PAYMENT_VERIFICATION=false
BBPS_PROVIDER=mock
BBPS_CONVENIENCE_FEE_FLAT=5

CITIZEN_JWT_SECRET=change-me-long-random
ADMIN_JWT_SECRET=change-me-long-random
CITIZEN_JWT_EXPIRES_IN=15m
ADMIN_JWT_EXPIRES_IN=15m
CITIZEN_JWT_AUDIENCE=cybersave-mobile
ADMIN_JWT_AUDIENCE=cybersave-admin
CITIZEN_REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_REFRESH_TOKEN_EXPIRES_DAYS=7
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6
