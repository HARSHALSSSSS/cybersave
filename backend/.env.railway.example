# Application
NODE_ENV=production
PORT=8000
API_PREFIX=api/v1

# Database — Railway Postgres plugin sets this automatically when linked
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Redis optional for now (not required to boot)
REDIS_URL=

# JWT — Citizen (mobile) — use long random secrets in production
CITIZEN_JWT_SECRET=change-me-citizen-jwt-secret-min-32-chars
CITIZEN_JWT_EXPIRES_IN=15m
CITIZEN_JWT_AUDIENCE=cybersave-mobile
CITIZEN_REFRESH_TOKEN_EXPIRES_DAYS=30

# JWT — Admin
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_JWT_AUDIENCE=cybersave-admin
ADMIN_REFRESH_TOKEN_EXPIRES_DAYS=7

# OTP
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

# Storage (local disk on Railway is ephemeral — fine for demos)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_UPLOAD_URL_TTL_SECONDS=900
# After first deploy, set this to your public Railway URL + prefix, e.g.:
# STORAGE_PUBLIC_BASE_URL=https://your-app.up.railway.app/api/v1/storage/local

# CORS — add your admin + any web origins
CORS_ORIGINS=https://your-admin.vercel.app,http://localhost:5173

# Swagger
SWAGGER_ENABLED=true

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
OTP_THROTTLE_TTL_MS=60000
OTP_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=900000
LOGIN_THROTTLE_LIMIT=10

# Demo / mock providers
SMS_PROVIDER=console
PAYMENT_PROVIDER=mock
SKIP_PAYMENT_VERIFICATION=true
BBPS_PROVIDER=mock
BBPS_CONVENIENCE_FEE_FLAT=5
BBPS_POLL_INTERVAL_MS=1500
BBPS_POLL_MAX_ATTEMPTS=30
