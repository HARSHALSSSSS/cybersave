# Application
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://cybersave:cybersave@localhost:5432/cybersave?schema=public

# Redis (future BullMQ jobs)
REDIS_URL=redis://localhost:6379

# JWT — Citizen (mobile)
CITIZEN_JWT_SECRET=change-me-citizen-jwt-secret-min-32-chars
CITIZEN_JWT_EXPIRES_IN=15m
CITIZEN_JWT_AUDIENCE=cybersave-mobile
CITIZEN_REFRESH_TOKEN_EXPIRES_DAYS=30

# JWT — Admin
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_JWT_AUDIENCE=cybersave-admin
ADMIN_REFRESH_TOKEN_EXPIRES_DAYS=7

# OTP (development — logs to console when SMS provider not configured)
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_UPLOAD_URL_TTL_SECONDS=900

# CORS (include 127.0.0.1 when web dev server uses that host for Firebase phone auth)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8081

# Swagger
SWAGGER_ENABLED=true

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
OTP_THROTTLE_TTL_MS=60000
OTP_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=900000
LOGIN_THROTTLE_LIMIT=10

# SMS / WhatsApp OTP (Meta WhatsApp Cloud API — production)
# Local dev: keep console + fixed OTP 123456 in API response
SMS_PROVIDER=console

# WhatsApp Cloud API (Meta Business) — set SMS_PROVIDER=whatsapp in production
# AUTH_PROVIDER=legacy uses backend OTP (WhatsApp delivery when SMS_PROVIDER=whatsapp)
AUTH_PROVIDER=legacy
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Must match an approved template in Meta Business Manager
WHATSAPP_OTP_TEMPLATE_NAME=cybersave_otp
WHATSAPP_TEMPLATE_LANGUAGE=en
# body = one body variable; auth = Meta authentication template with copy-code button
WHATSAPP_OTP_TEMPLATE_STYLE=body
WHATSAPP_API_VERSION=v21.0

# Firebase Phone Auth (optional legacy — not used with WhatsApp OTP)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key from Firebase service account JSON (keep quotes; use \n for newlines)
FIREBASE_PRIVATE_KEY=

# Payments — set PAYMENT_PROVIDER=razorpay plus RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
# If those keys are present (rzp_...), Standard Checkout is used even if provider is still mock.
PAYMENT_PROVIDER=razorpay
SKIP_PAYMENT_VERIFICATION=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# BBPS Bill Payments (mock provider until Razorpay BBPS keys are configured)
BBPS_PROVIDER=mock
BBPS_CONVENIENCE_FEE_FLAT=5
BBPS_POLL_INTERVAL_MS=1500
BBPS_POLL_MAX_ATTEMPTS=30
