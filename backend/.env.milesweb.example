# Copy to .env in the backend folder on MilesWeb (File Manager → Add New → File → .env)
# Replace DATABASE_URL with your Neon connection string.

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
AUTO_SEED=true

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=https://cybersaveonline.com/api/v1/storage/local

CORS_ORIGINS=https://cybersaveonline.com,https://www.cybersaveonline.com
SKIP_PAYMENT_VERIFICATION=true
PAYMENT_PROVIDER=mock
SMS_PROVIDER=console
