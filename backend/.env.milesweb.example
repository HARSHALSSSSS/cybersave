# Copy this file to `.env` in the backend folder on MilesWeb
# (cPanel File Manager → backend → New File → .env)
#
# MilesWeb Node.js app settings:
#   Working Directory = backend
#   Startup Command   = node dist/main.js
#   Port              = 3000
#
# Then run on the server: npm install && npx prisma generate && npm run build

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

CITIZEN_JWT_SECRET=change-me-citizen-jwt-secret-min-32-chars
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars
CITIZEN_JWT_EXPIRES_IN=15m
ADMIN_JWT_EXPIRES_IN=15m
CITIZEN_JWT_AUDIENCE=cybersave-mobile
ADMIN_JWT_AUDIENCE=cybersave-admin
CITIZEN_REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_REFRESH_TOKEN_EXPIRES_DAYS=7

OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=https://api.cybersaveonline.com/api/v1/storage/local

CORS_ORIGINS=https://cybersaveonline.com,https://www.cybersaveonline.com,https://api.cybersaveonline.com
SWAGGER_ENABLED=true

SMS_PROVIDER=console
PAYMENT_PROVIDER=razorpay
SKIP_PAYMENT_VERIFICATION=false
BBPS_PROVIDER=mock
BBPS_CONVENIENCE_FEE_FLAT=5
