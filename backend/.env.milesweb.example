# Copy to `.env` on MilesWeb (cPanel File Manager → backend folder)
#
# MilesWeb Node.js app:
#   Node version        = 20.x
#   Application root    = backend
#   Startup command     = node dist/main.js
#
# After upload, in cPanel terminal:
#   cd backend
#   npm install
#   npx prisma generate
#   npm run build
#   npx prisma migrate deploy
#   npx ts-node --transpile-only prisma/seed.ts    # first time only
#
# Then restart the Node app from cPanel.

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Cloud Postgres (Neon / Supabase / host DB) — must include sslmode for remote DBs
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cybersave?sslmode=require

# JWT — use long random strings (32+ chars each)
CITIZEN_JWT_SECRET=CHANGE_ME_citizen_jwt_min_32_chars
ADMIN_JWT_SECRET=CHANGE_ME_admin_jwt_min_32_chars
CITIZEN_JWT_EXPIRES_IN=15m
ADMIN_JWT_EXPIRES_IN=15m
CITIZEN_JWT_AUDIENCE=cybersave-mobile
ADMIN_JWT_AUDIENCE=cybersave-admin
CITIZEN_REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_REFRESH_TOKEN_EXPIRES_DAYS=7

OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

# WhatsApp OTP (Meta Cloud API) — production
AUTH_PROVIDER=legacy
SMS_PROVIDER=whatsapp
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_OTP_TEMPLATE_NAME=cybersave_otp
WHATSAPP_TEMPLATE_LANGUAGE=en
# body = one body variable; auth = Meta authentication template with copy-code button
WHATSAPP_OTP_TEMPLATE_STYLE=body
WHATSAPP_API_VERSION=v21.0

# Firebase (optional legacy — not used when AUTH_PROVIDER=legacy + SMS_PROVIDER=whatsapp)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Your live site origins (comma-separated, no spaces)
CORS_ORIGINS=https://cybersaveonline.com,https://www.cybersaveonline.com,https://api.cybersaveonline.com

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=https://api.cybersaveonline.com/api/v1/storage/local
STORAGE_UPLOAD_URL_TTL_SECONDS=900

SWAGGER_ENABLED=true

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
OTP_THROTTLE_TTL_MS=60000
OTP_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=900000
LOGIN_THROTTLE_LIMIT=10

PAYMENT_PROVIDER=razorpay
SKIP_PAYMENT_VERIFICATION=false
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=

BBPS_PROVIDER=mock
BBPS_CONVENIENCE_FEE_FLAT=5
BBPS_POLL_INTERVAL_MS=2000
BBPS_POLL_MAX_ATTEMPTS=30
