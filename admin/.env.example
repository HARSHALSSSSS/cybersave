# Cybersave Admin — Vite environment variables
# Local backend:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Hosted Render API:
# VITE_API_BASE_URL=https://cybersave-l972.onrender.com/api/v1
# Path prefix for built assets:
#   /admin  — served by API at https://your-api.onrender.com/admin/
#   /       — standalone Render Static Site at its own URL
VITE_ADMIN_BASE=/admin
VITE_APP_NAME=Cybersave Admin
VITE_APP_ENV=development
