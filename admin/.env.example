# Cybersave Admin — Vite environment variables
# Local backend:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Hosted Render API:
# VITE_API_BASE_URL=https://api.cybersaveonline.com/api/v1
# Path prefix for built assets (default / for Render Static Site cybersave-2):
#   /       — https://cybersave-2.onrender.com/
#   /admin  — only if served by the API at ...onrender.com/admin/
VITE_ADMIN_BASE=/
VITE_APP_NAME=Cybersave Admin
VITE_APP_ENV=development
