# Cybersave Mobile (optional dev overrides)
#
# API host is configured in app/config/env.ts:
#   USE_HOSTED_API = true  → Render (https://cybersave-l972.onrender.com/api/v1)
#   USE_HOSTED_API = false → local backend (Metro / emulator / LAN)
#
# If OTP/login fails on a physical device with local backend, set your PC's LAN IP:
# DEV_API_HOST=192.168.1.42
#
# Then rebuild the app, or use USB:
#   adb reverse tcp:8000 tcp:8000
