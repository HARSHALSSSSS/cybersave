# Cybersave Mobile — API configuration
#
# Primary config: app/config/env.ts
#   __DEV__ (Metro)     → local backend (same as web localhost:8000)
#   release builds      → https://api.cybersaveonline.com/api/v1
#
# To force hosted API while developing, set USE_HOSTED_API = true in env.ts
# For local dev on a physical device, set your PC's LAN IP in env.ts:
#   DEV_API_HOST_OVERRIDE = '192.168.1.42'
#
# Or use USB port forwarding:
#   adb reverse tcp:8000 tcp:8000
