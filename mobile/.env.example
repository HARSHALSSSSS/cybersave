# Cybersave Mobile — API configuration
#
# Primary config: app/config/env.ts
#
# USE_HOSTED_API = true  → https://api.cybersaveonline.com/api/v1 (dev + testing)
# USE_HOSTED_API = false → local backend in Metro (__DEV__ only)
#
# Release APK / IPA always uses the hosted API regardless of USE_HOSTED_API.
#
# Local dev on a physical device (when USE_HOSTED_API = false):
#   DEV_API_HOST_OVERRIDE = '192.168.1.42'  in env.ts
#   or: adb reverse tcp:8000 tcp:8000
#
# Firebase (required for phone OTP on device):
#   Android: mobile/android/app/google-services.json
#   iOS:     mobile/ios/Cybersave/GoogleService-Info.plist
