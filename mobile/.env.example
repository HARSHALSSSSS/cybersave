# Cybersave Mobile (optional dev overrides)
#
# API host is auto-detected from Metro in app/config/env.ts.
# If OTP/login fails on a physical device, set your PC's LAN IP:
# DEV_API_HOST=192.168.1.42
#
# Then rebuild the app, or use USB:
#   adb reverse tcp:8000 tcp:8000
#
# Production API:
# API_BASE_URL=https://api.cybersave.gov.in/api/v1
