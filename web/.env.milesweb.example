# MilesWeb production — copy to web/.env before: npm run build
# Upload contents of web/dist/ to public_html/ (cybersaveonline.com)

VITE_API_BASE_URL=https://api.cybersaveonline.com/api/v1
VITE_APP_NAME=Cybersave

# Firebase Phone Auth (from Firebase Console → Web app config)
VITE_USE_FIREBASE_AUTH=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cybersave-ba1c9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cybersave-ba1c9
VITE_FIREBASE_MESSAGING_SENDER_ID=215164240561
VITE_FIREBASE_APP_ID=1:215164240561:web:179ccd99bc6913e6085890

# Do NOT set test mode in production — requires Firebase Blaze for real SMS
