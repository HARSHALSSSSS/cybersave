# Cybersave Citizen Web Portal — Vite environment variables
#
# Local development (backend on port 8000):
VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Production (your live Render API):
# VITE_API_BASE_URL=https://api.cybersaveonline.com/api/v1
#
VITE_APP_NAME=Cybersave
#
# Firebase → Authentication → Settings → Authorized domains: add 127.0.0.1 (NOT localhost — blocked for phone auth)
# Open the dev app at http://127.0.0.1:5174 (vite is configured for 127.0.0.1, not localhost)
VITE_USE_FIREBASE_AUTH=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional: fictional test numbers only (Firebase Console → Phone → Phone numbers for testing)
# Required for local dev without Blaze billing — real SMS needs Firebase paid plan
VITE_FIREBASE_AUTH_TEST_MODE=true
#
# Backend CORS: on Render → cybersave-api → Environment, set:
# CORS_ORIGINS=https://YOUR-WEB.onrender.com,https://YOUR-ADMIN.onrender.com
# (or keep CORS_ORIGINS=* for a quick first deploy)
#
# File uploads: set STORAGE_PUBLIC_BASE_URL on the API for production, e.g.
# STORAGE_PUBLIC_BASE_URL=https://api.cybersaveonline.com
