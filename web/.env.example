# Cybersave Citizen Web Portal — Vite environment variables
#
# Local development (backend on port 8000):
VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Production (your live Render API):
# VITE_API_BASE_URL=https://api.cybersaveonline.com/api/v1
#
VITE_APP_NAME=Cybersave
#
# Backend CORS: on Render → cybersave-api → Environment, set:
# CORS_ORIGINS=https://YOUR-WEB.onrender.com,https://YOUR-ADMIN.onrender.com
# (or keep CORS_ORIGINS=* for a quick first deploy)
#
# File uploads: set STORAGE_PUBLIC_BASE_URL on the API for production, e.g.
# STORAGE_PUBLIC_BASE_URL=https://api.cybersaveonline.com
