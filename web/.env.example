# Cybersave Citizen Web Portal — Vite environment variables
#
# Local development (backend on port 8000):
VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Production (set to your deployed NestJS API):
# VITE_API_BASE_URL=https://your-api.example.com/api/v1
#
VITE_APP_NAME=Cybersave
#
# Backend CORS: add your web origin to CORS_ORIGINS in backend/.env
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://portal.cybersave.gov.in
#
# File uploads: if presigned URLs point at localhost storage, ensure STORAGE_PUBLIC_BASE_URL
# is set correctly on the backend for production.
